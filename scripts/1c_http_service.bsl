// ----------------------------------------------------------------------------
// 1-VARIANT: Standard 1C bazalari uchun (УТ 11, УНФ, Розница, ERP)
// (Narxlar 'ЦеныНоменклатуры.СрезПоследних' registridan olinadi)
// ----------------------------------------------------------------------------
Функция GetTovarList(Запрос)
    
    Попытка
        ЗапросЗапрос = Новый Запрос;
        ЗапросЗапрос.Текст = 
            "ВЫБРАТЬ
            |	Номенклатура.Код КАК id,
            |	ЕСТЬНУЛЛ(Номенклатура.Артикул, Номенклатура.Код) КАК sku,
            |	Номенклатура.Наименование КАК name,
            |	ЕСТЬНУЛЛ(Цены.Цена, 0) КАК price,
            |	ЕСТЬНУЛЛ(Номенклатура.Родитель.Наименование, """") КАК category
            |ИЗ
            |	Справочник.Номенклатура КАК Номенклатура
            |	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ТекущаяДата, ) КАК Цены
            |		ПО Номенклатура.Ссылка = Цены.Номенклатура
            |ГДЕ
            |	НЕ Номенклатура.ПометкаУдаления
            |	И НЕ Номенклатура.ЭтоГруппа"; // Papka (Guruh) larni chiqarib tashlaymiz
            
        ЗапросЗапрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
        Результат = ЗапросЗапрос.Выполнить().Выгрузить();
        
        СписокТоваров = Новый Массив;
        Для Каждого Стр Из Результат Цикл
            Товар = Новый Структура;
            Товар.Вставить("id", СокрЛП(Стр.id));
            Товар.Вставить("sku", СокрЛП(Стр.sku));
            Товар.Вставить("name", СокрЛП(Стр.name));
            Товар.Вставить("price", Число(Стр.price));
            Товар.Вставить("category", СокрЛП(Стр.category));
            
            СписокТоваров.Добавить(Товар);
        КонецЦикла;
        
        // JSON formatga o'girish (UTF-8, BOMsiz)
        ЗаписьJSON = Новый ЗаписьJSON;
        ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ", Истина);
        ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
        ЗаписатьJSON(ЗаписьJSON, СписокТоваров);
        СтрокаJSON = ЗаписьJSON.Закрыть();
        
        // HTTP Javob shakllantirish (200 OK)
        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        
        Возврат Ответ;
        
    Исключение
        // Xatolik yuz berganda 500 status va JSON qaytarish
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        СтруктураОшибки = Новый Структура;
        СтруктураОшибки.Вставить("success", Ложь);
        СтруктураОшибки.Вставить("error", ОписаниеОшибки());
        ЗаписатьJSON(ЗаписьJSON, СтруктураОшибки);
        
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        
        Возврат Ответ;
    КонецПопытки;

КонецФункции


